# Copy to .env.local and fill in. Never commit .env.local.
# Provider: gemini (free tier) or anthropic (Claude Console credits)
VISION_PROVIDER=gemini

GEMINI_API_KEY=
# Current Flash model name from Google AI Studio
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Set to 1 to use mock analysis results in the UI (no API calls)
NEXT_PUBLIC_USE_MOCK=0
